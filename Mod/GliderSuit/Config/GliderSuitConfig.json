{
  // Glider Suit settings. Edit and save, then restart the game (or type
  // "glider reload" in the console). A value outside its range is ignored and
  // the default is used; the game's log says which.

  // --- Flight ---
  "cruise_speed": 25,           // 6-40 m/s: the speed the glider settles at
  "glide_ratio": 12.0,          // 1.5-12: metres forward per metre lost at cruise; lower sinks faster
  "launch_speed": 12,           // 0-40 m/s: speed boost on the first opening after leaving the ground; 0 = off
  "turn_rate": 40,              // 10-180 deg/s: how fast Left/Right turn you

  // --- Damage ---
  "crash_damage_scale": 0.5,    // 0-5: how hard a glider crash or landing hurts. 0.5 = like hitting at half
                                // the speed, 1 = full fall damage, 0 = none. Folding and falling is always
                                // full fall damage

  // --- View ---
  "auto_third_person": true,    // switch to third person while gliding, and back when you fold
  "glide_camera": true,         // in third person, a centred camera further behind you while gliding
  "camera_roll_angle": 8,       // 0-30 degrees: camera roll in a full turn; 0 = off
  "fp_wings": true,             // show the wings overhead in first person

  // --- Sound ---
  "wind_volume": 0.5,           // 0-1: wind loudness at cruise speed; 0 = silent

  // --- Troubleshooting ---
  "debug": false                // true = detailed log lines and an on-screen readout
}
